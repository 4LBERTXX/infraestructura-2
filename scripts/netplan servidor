# Ubuntu SERVIDOR - IP estatica en la red 10.22.41.128/28
# Gateway: router Cisco (FastEthernet1/1 = 10.22.41.129)
# Copiar a /etc/netplan/ (el nombre del archivo puede variar) y ejecutar: sudo netplan apply
network:
  version: 2
  ethernets:
    ens3:
      dhcp4: false
      addresses:
        - 10.22.41.130/28
      routes:
        - to: default
          via: 10.22.41.129
      nameservers:
        addresses: [1.1.1.1]
